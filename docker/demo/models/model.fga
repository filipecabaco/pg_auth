model
  schema 1.1
type user
type org
  relations
    define admin: [user]
    define member: [user]
    define can_manage: admin
    define can_read: member or admin
type document
  relations
    define org: [org]
    define shared_with: [user]
    define viewer: shared_with or can_read from org
    define editor: can_manage from org
